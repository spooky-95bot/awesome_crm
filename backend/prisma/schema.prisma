// backend/prisma/schema.prisma
// Phase 1 — Modèle de données de base : User, Role, Permission + tables de liaison + RefreshToken.
// Les tables de liaison sont modélisées explicitement → ajout ultérieur de champs (auteur/date) possible.

generator client {
  provider      = "prisma-client-js"
  // Yerel (native) + Docker alpine (musl/openssl3) hedefleri.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String // bcrypt; düz parola ASLA saklanmaz
  firstName     String
  lastName      String
  isActive      Boolean        @default(true)
  // v2.10 multi-tenant : l'utilisateur est rattaché à un tenant (null = plateforme/inter-tenant).
  tenantId      String?
  roles         UserRole[]
  refreshTokens RefreshToken[]
  ownedDeals    Deal[]         @relation("DealOwner")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
  @@index([tenantId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // örn: ADMIN, SALES, FINANCE
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  // "kaynak.eylem" biçimi — örn: "deal.create", "invoice.read"
  action      String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

// --- Tables de liaison : many-to-many modélisé explicitement ---

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String // Hash SHA-256 du refresh token ; le token brut n'est jamais stocké
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== Phase 3 — Ventes (Deal) & Kanban =====

model Pipeline {
  id        String   @id @default(uuid())
  name      String
  isDefault Boolean  @default(false)
  stages    Stage[]
  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stage {
  id         String   @id @default(uuid())
  pipelineId String
  name       String // ex. : Nouveau, Contact, Devis, Gagné, Perdu
  position   Int // ordre de colonne
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals      Deal[]

  @@unique([pipelineId, position])
  @@index([pipelineId])
}

enum DealStatus {
  OPEN
  WON
  LOST
}

model Deal {
  id           String         @id @default(uuid())
  pipelineId   String
  stageId      String
  title        String
  contactName  String?
  email        String?
  phone        String?
  company      String?
  value        Decimal?       @db.Decimal(14, 2) // valeur estimée
  currency     String         @default("EUR")
  // Ordre dans le Kanban — rang fractionnaire (déplacement sans collision)
  rank         Decimal        @db.Decimal(30, 15)
  ownerId      String? // commercial assigné
  // v2.1 : Deal est désormais lié à Contact/Company (nullable — migration progressive).
  contactId    String?
  companyId    String?
  customFields Json?
  status       DealStatus     @default(OPEN)
  pipeline     Pipeline       @relation(fields: [pipelineId], references: [id])
  stage        Stage          @relation(fields: [stageId], references: [id])
  owner        User?          @relation("DealOwner", fields: [ownerId], references: [id])
  activities   DealActivity[]
  invoices     Invoice[]
  quotes       Quote[]
  saleLineItems SaleLineItem[]
  // Phase 6 multi-tenant : nullable (migration progressive). Assigné/filtré automatiquement si le contexte est actif.
  tenantId     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime? // soft delete

  @@index([stageId, rank])
  @@index([ownerId])
  @@index([pipelineId, status])
  @@index([tenantId])
  @@index([contactId])
  @@index([companyId])
}

model DealActivity {
  id        String   @id @default(uuid())
  dealId    String
  userId    String
  type      String // NOTE, STAGE_CHANGE, CALL, EMAIL
  payload   Json? // {from, to} vb.
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
}

model SaleLineItem {
  id          String   @id @default(uuid())
  dealId      String
  productId   String?
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(14, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([productId])
}

// ===== Faz 4 — Finans & Fatura =====

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id            String            @id @default(uuid())
  number        String?           @unique // INV-2026-000123 (assigné à l'émission ; séquentiel, sans saut)
  dealId        String?
  customerName  String
  customerEmail String?
  status        InvoiceStatus     @default(DRAFT)
  currency      String            @default("EUR")
  pricesIncludeTax Boolean        @default(false) // true = unitPrice TTC (prix affichés Elysence)
  subtotal      Decimal           @db.Decimal(14, 2)
  taxRate       Decimal           @db.Decimal(5, 2) // % KDV
  taxAmount     Decimal           @db.Decimal(14, 2)
  total         Decimal           @db.Decimal(14, 2)
  amountPaid    Decimal           @default(0) @db.Decimal(14, 2)
  issuedAt      DateTime?
  dueAt         DateTime?
  deal          Deal?             @relation(fields: [dealId], references: [id])
  lineItems     InvoiceLineItem[]
  payments      Payment[]
  paymentIntents PaymentIntent[]
  createdById   String
  tenantId      String? // Phase 6 multi-tenant (nullable, migration progressive)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([dealId])
  @@index([dueAt])
  @@index([tenantId])
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  lineTotal   Decimal @db.Decimal(14, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id           String   @id @default(uuid())
  invoiceId    String
  amount       Decimal  @db.Decimal(14, 2)
  method       String // BANK, CARD, CASH
  reference    String?
  paidAt       DateTime @default(now())
  recordedById String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Compteur annuel de numéros de facture séquentiels (production sans saut).
model InvoiceCounter {
  year       Int @id
  lastNumber Int @default(0)
}

// v4.6 — Intention de paiement (iyzico). Correspondance token↔facture + idempotence.
// Callback NON SIGNÉ (redirection navigateur) → le corps n'est pas fiable ; vérification
// "retrieve" serveur-à-serveur avec le token ; si SUCCESS, le statut passe pending→paid de façon ATOMIQUE et
// un seul enregistrement Payment est créé (double callback = no-op idempotent).
model PaymentIntent {
  id             String   @id @default(uuid())
  tenantId       String?
  invoiceId      String
  provider       String   @default("iyzico")
  token          String   @unique // token du formulaire de paiement iyzico
  conversationId String   @unique // identifiant unique que nous générons (renvoyé en écho à iyzico)
  amount         Decimal  @db.Decimal(14, 2) // montant attendu du paiement (solde restant)
  currency       String   @default("EUR")
  status         String   @default("pending") // pending | paid | failed
  providerRef    String? // iyzico paymentId
  createdById    String // utilisateur ayant initié l'intention → Payment.recordedById
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceId])
  @@index([tenantId])
}

// ===== v2.7 — Ürün & Teklif (CPQ) =====

model Product {
  id          String          @id @default(uuid())
  sku         String?         @unique
  name        String
  description String?
  unitPrice   Decimal         @db.Decimal(14, 2)
  currency    String          @default("EUR")
  taxRate     Decimal         @default(0) @db.Decimal(5, 2) // % TVA par défaut
  active      Boolean         @default(true)
  tenantId    String?
  deletedAt   DateTime? // soft delete (hard delete yok)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  quoteItems  QuoteLineItem[]
  saleLineItems SaleLineItem[]
  invoiceLineItems InvoiceLineItem[]

  @@index([active])
  @@index([tenantId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model Quote {
  id                 String          @id @default(uuid())
  number             String?         @unique // QUO-2026-000123 (assigné à l'envoi)
  dealId             String?
  customerName       String
  customerEmail      String?
  status             QuoteStatus     @default(DRAFT)
  currency           String          @default("EUR")
  subtotal           Decimal         @db.Decimal(14, 2)
  taxRate            Decimal         @db.Decimal(5, 2)
  taxAmount          Decimal         @db.Decimal(14, 2)
  total              Decimal         @db.Decimal(14, 2)
  validUntil         DateTime?
  convertedInvoiceId String?         @unique // facture convertie (idempotence)
  deal               Deal?           @relation(fields: [dealId], references: [id])
  lineItems          QuoteLineItem[]
  createdById        String
  tenantId           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status])
  @@index([dealId])
  @@index([tenantId])
}

model QuoteLineItem {
  id          String   @id @default(uuid())
  quoteId     String
  productId   String?
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(14, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@index([productId])
}

// Compteur annuel de numéros de devis séquentiels.
model QuoteCounter {
  year       Int @id
  lastNumber Int @default(0)
}

// ===== Phase 5 — Intégrations externes =====

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  DEAD
}

model WebhookSubscription {
  id          String            @id @default(uuid())
  url         String
  events      String[] // ["deal.created","invoice.paid"]
  secret      String // clé de signature HMAC (renvoyée uniquement à la création ; ensuite secrète)
  isActive    Boolean           @default(true)
  createdById String
  createdAt   DateTime          @default(now())
  deliveries  WebhookDelivery[]
}

model WebhookDelivery {
  id             String              @id @default(uuid())
  subscriptionId String
  event          String
  payload        Json
  status         DeliveryStatus      @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?
  nextRetryAt    DateTime?
  signature      String
  createdAt      DateTime            @default(now())
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([subscriptionId])
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  template  String
  status    String // SENT, FAILED, SIMULATED
  error     String?
  createdAt DateTime @default(now())
}

// Clés d'idempotence des webhooks entrants (empêche le retraitement).
model ProcessedWebhook {
  key       String   @id // source + delivery id
  source    String
  createdAt DateTime @default(now())
}

// ===== Faz 6 — Multi-tenancy =====

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ===== File d'attente e-mail persistante (Elysence / Atelier) =====
// Souveraine : la logique (file, reprise, idempotence, journal) nous appartient.
// Le transport reste interchangeable (simulated | smtp | api).
model EmailOutbox {
  id             String    @id @default(uuid())
  tenantId       String? // séparation par projet/client (nullable, migration douce)
  to             String
  subject        String
  template       String
  context        Json
  status         String    @default("PENDING") // PENDING, SENDING, SENT, SIMULATED, FAILED, DEAD
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lastError      String?
  nextAttemptAt  DateTime  @default(now())
  idempotencyKey String    @unique // empêche tout doublon (ex: reservationId + type)
  driver         String? // transport réellement utilisé au dernier essai
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([tenantId])
}

// ===== v2.1 — Çekirdek CRM nesneleri: Company & Contact =====

model Company {
  id        String    @id @default(uuid())
  name      String
  domain    String?
  industry  String?
  phone     String?
  website   String?
  ownerId   String?
  tenantId  String? // multi-tenancy (otomatik filtre)
  contacts  Contact[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
  @@index([name])
}

model Contact {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?
  tenantId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([tenantId])
  @@index([email])
}

// ===== v2.1c — Lead non qualifié (converti en Contact+Deal) =====

enum LeadStatus {
  NEW
  WORKING
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

// Canal d'ENTRÉE du lead dans le système (comment il est arrivé) — distinct du texte libre `source`,
// structuré et filtrable. MANUAL : saisie manuelle ; IMPORT : import CSV ;
// FORM : formulaire intégrable ; WEBHOOK : webhook signé serveur-à-serveur ; API : API directe.
enum LeadChannel {
  MANUAL
  IMPORT
  FORM
  WEBHOOK
  API
}

model Lead {
  id                 String      @id @default(uuid())
  firstName          String
  lastName           String
  email              String?
  phone              String?
  companyName        String?
  source             String? // alt-kaynak (serbest): WEB, REFERRAL, EVENT, ...
  channel            LeadChannel @default(MANUAL) // canal d'entrée (structuré)
  formId             String? // formulaire source pour le canal FORM
  meta               Json? // ham yük / ekstra alanlar (form-özel alanlar, webhook gövdesi)
  status             LeadStatus  @default(NEW)
  ownerId            String?
  tenantId           String?
  convertedContactId String?
  convertedDealId    String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  form LeadForm? @relation(fields: [formId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([channel])
  @@index([formId])
}

// ===== Lead Intake — Embed edilebilir form + gelen webhook =====
// Formulaire embarqué : intégré à des sites tiers via iframe/script ; soumission non signée avec publicKey
// (public par défaut). Webhook : ingestion serveur-à-serveur signée HMAC avec le `secret` du même formulaire
// (docs/90 §webhook : AUCUNE écriture en base sans vérification de la signature).
model LeadForm {
  id             String   @id @default(uuid())
  tenantId       String?
  name           String
  publicKey      String   @unique // utilisé dans l'URL d'embed et la soumission (non secret)
  secret         String // pour la signature HMAC du webhook (serveur-à-serveur uniquement ; jamais exposé à l'embed)
  fields         Json     @default("[]") // [{ key, label, type, required }]
  buttonColor    String   @default("#4f46e5")
  buttonLabel    String   @default("Gönder")
  successMessage String?
  redirectUrl    String? // redirection après soumission (option.)
  isActive       Boolean  @default(true)
  submitCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leads Lead[]

  @@index([tenantId])
}

// ===== v2.2 — Calendrier / Rendez-vous =====

model Meeting {
  id        String   @id @default(uuid())
  title     String
  startsAt  DateTime
  endsAt    DateTime
  location  String?
  notes     String?
  dealId    String?
  contactId String?
  ownerId   String?
  tenantId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([startsAt])
  @@index([tenantId])
}

// ===== v2.3 — Règles d'automatisation =====

model AutomationRule {
  id          String   @id @default(uuid())
  name        String
  trigger     String // 'deal.created' | 'deal.moved' | 'lead.created' | 'invoice.paid' | 'invoice.issued'
  conditions  Json? // { field, equals }
  actions     Json // [{ type, ... }]
  isActive    Boolean  @default(true)
  createdById String?
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([trigger, isActive])
  @@index([tenantId])
}

// ===== v2.5 — Özel alanlar (low-code) =====

enum CustomFieldEntity {
  DEAL
  CONTACT
  COMPANY
  LEAD
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
}

model CustomFieldDef {
  id        String            @id @default(uuid())
  entity    CustomFieldEntity
  key       String
  label     String
  type      CustomFieldType
  options   String[]          @default([]) // SELECT için
  required  Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@unique([entity, key])
  @@index([entity])
}

// ===== v2.9 — Maturité plateforme (journal d'audit) =====

// Toutes les requêtes modifiantes sont enregistrées (append-only ; pas de suppression définitive).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String // HTTP metodu (POST/PATCH/DELETE)
  entity     String // yol segmenti (deals, invoices, ...)
  entityId   String?
  path       String
  statusCode Int
  tenantId   String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entity, createdAt])
  @@index([createdAt])
}

// ===== Marque (logo + nom d'application) — modifiable depuis le panneau, ligne unique =====
model Branding {
  id        String   @id @default("singleton")
  appName   String?
  logo      String?  @db.Text // data URL (image/svg+xml ou png) — logo par défaut si vide
  updatedAt DateTime @updatedAt
}

// ===== v3.0 — Connexions d'intégration (connectées depuis le panneau ; secrets chiffrés AES-256-GCM) =====
model Connection {
  id         String   @id @default(uuid())
  tenantId   String?
  provider   String // 'whatsapp' | 'stripe' | 'quickbooks' | ...
  label      String?
  status     String   @default("connected") // connected | disabled
  secretsEnc String?  @db.Text // JSON chiffré AES-256-GCM (champs secrets) — jamais stocké en clair
  config     Json? // gizli olmayan meta (ör. phoneNumberId)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([provider])
}

// ===== v3.1 — Messages WhatsApp (envoyés + reçus ; liés au lead/contact) =====
model WhatsAppMessage {
  id        String   @id @default(uuid())
  tenantId  String?
  direction String // IN | OUT
  phone     String // numéro du correspondant (E.164, le + est optionnel)
  body      String   @db.Text
  status    String   @default("sent") // sent | failed | received
  error     String?
  waId      String? // identifiant du message chez le fournisseur (wamid...)
  leadId    String?
  contactId String?
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([leadId])
  @@index([contactId])
  @@index([tenantId])
}

// ===== v3.2 — Muhasebe senkronu (fatura → QuickBooks/Xero) =====
model AccountingSync {
  id         String   @id @default(uuid())
  invoiceId  String   @unique
  provider   String // quickbooks | xero
  externalId String? // identifiant de facture chez le fournisseur
  status     String   @default("PENDING") // PENDING | SYNCED | FAILED
  error      String?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

// ===== v4.0 — Radar de marques : marques propres de l'utilisateur + profil de niche =====
model Brand {
  id             String   @id @default(uuid())
  tenantId       String?
  name           String
  sector         String? // örn: Giyim
  niche          String? // niche normalisée, ex. : "mode urbaine homme"
  description    String?  @db.Text
  targetAudience String?
  priceBand      String? // budget | mid | premium | luxury
  markets        Json     @default("[]") // codes pays : ["FR","DE"]
  keywords       Json     @default("[]") // mots-clés de la niche
  answers        Json? // réponses brutes au questionnaire d'onboarding
  aiEnriched     Boolean  @default(false)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

// ===== v4.1 — Fiche concurrent (liée à la marque ; manuelle ou suggérée par IA) =====
model Competitor {
  id        String   @id @default(uuid())
  tenantId  String?
  brandId   String
  name      String
  domain    String?
  instagram String?
  notes     String?  @db.Text
  source    String   @default("manual") // manual | ai_suggested
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([tenantId])
}

// ===== v4.2 — Publicités enregistrées (mises en favori depuis le radar Meta Ad Library) =====
model SavedAd {
  id          String   @id @default(uuid())
  tenantId    String?
  brandId     String
  adArchiveId String
  pageName    String?
  body        String?  @db.Text
  snapshotUrl String?
  startTime   String?
  platforms   Json?
  createdAt   DateTime @default(now())

  @@unique([brandId, adArchiveId])
  @@index([brandId])
  @@index([tenantId])
}

// ===== v4.4 — Suivi produits & prix concurrents (CSV/manuel ; historique des prix) =====
model CompetitorProduct {
  id        String       @id @default(uuid())
  tenantId  String?
  brandId   String
  name      String
  url       String?
  currency  String       @default("EUR")
  price     Decimal      @db.Decimal(14, 2)
  source    String       @default("csv") // csv | manual
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  prices    PricePoint[]

  @@unique([brandId, name])
  @@index([brandId])
  @@index([tenantId])
}

model PricePoint {
  id         String            @id @default(uuid())
  productId  String
  price      Decimal           @db.Decimal(14, 2)
  capturedAt DateTime          @default(now())
  product    CompetitorProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt])
}
