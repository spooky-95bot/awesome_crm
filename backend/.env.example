# backend/.env.example — copier : cp .env.example .env, puis remplir les valeurs réelles.

# --- Base de données ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="

# --- JWT ---
# Secrets DIFFÉRENTS, forts et aléatoires pour Access et Refresh (ex : openssl rand -base64 48)
# Use unique private secrets of at least 32 characters; sample values are intentionally omitted.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET="
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Parola ---
BCRYPT_COST=12

# --- Uygulama ---
NODE_ENV="development"
PORT=3000

# Origines autorisées séparées par des virgules (liste blanche CORS)
CORS_ORIGINS="http://localhost:3001"

# Drapeau Secure du cookie : true en production (HTTPS).
COOKIE_SECURE=false

# Login rate limit (örn. 60 sn'de 5 deneme)
THROTTLE_TTL=60
THROTTLE_LIMIT=5

# --- Seed (premier utilisateur admin) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD="

# --- Faz 5: Entegrasyonlar ---
# Mail sürücüsü: simulated (gerçekten göndermez, EmailLog yazar) | smtp
MAIL_DRIVER="simulated"
# SMTP (MAIL_DRIVER=smtp ise) — dev'de MailHog: host=localhost port=1025
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="crm@localhost"
# Resend (MAIL_DRIVER=resend) — transactionnel, sans filigrane sur le plan Free
# RESEND_API_KEY="re_xxxxxxxxx"
# RESEND_FROM="Maison ELYSENCE <maison@elysence.fr>"
# RESEND_REPLY_TO="reply@elysence.fr"

# --- v2.6: IA (Claude) — optionnel ; sans clé, les endpoints IA renvoient 503 ---
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"
# Webhook sortant : réseau privé + http autorisés (test/auto-hébergement uniquement ; false en production)
WEBHOOK_ALLOW_PRIVATE=false
# Secret de vérification HMAC du webhook entrant (vide → endpoint inbound 400)
INBOUND_WEBHOOK_SECRET=""
