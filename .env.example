# .env.example — KÖK (docker compose) ortam değişkenleri.
# Kopyala: cp .env.example .env  → değerleri doldur. .env repoya GİRMEZ.
# (Lokal, docker'sız backend geliştirme için ayrıca backend/.env kullanılır.)

# --- PostgreSQL (db servisi) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Backend runtime (env_file ile container'a yüklenir) ---
# NOT: compose, backend için DATABASE_URL'i otomatik 'db' servisine yönlendirir.
NODE_ENV=production
PORT=3000

# Provide strong, unique values through a private secret store before starting.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12

CORS_ORIGINS=http://localhost:3001
COOKIE_SECURE=true

THROTTLE_TTL=60
THROTTLE_LIMIT=5

# Set both only from a private secret store; no sample account is provisioned.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Entegrasyonlar (Faz 5) ---
MAIL_DRIVER=simulated
WEBHOOK_ALLOW_PRIVATE=false
INBOUND_WEBHOOK_SECRET=

# Integration connection secrets encryption (AES-256-GCM); base64 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# OAuth (v3.2): base URL registered as redirect origin + panel URL for post-auth redirect.
APP_PUBLIC_URL=http://localhost:3000
APP_PANEL_URL=http://localhost:3001
